# Die Pipeline braucht KEINE Umgebungsvariablen:
#
#   python3 -m src.run
#
# Gebraucht werden Variablen nur fuer die Modell-Tasks der Eval-Suite
# (kv_extraktion, moebliert). Nichts davon gehoert ins Repository - .env ist
# in .gitignore. Ein Schluessel wird nie in einen Chat oder Commit kopiert.

# evals/lauf.py liest .env nicht selbst; laden mit:  set -a; . ./.env; set +a

# ── evals/lauf.py (ohne Node) ───────────────────────────────────────────
# OpenAI-kompatibler Endpunkt. Voreinstellung: LM Studio lokal.
EVAL_BASE_URL=http://localhost:1234/v1
# Gepinntes Modell; ein anderes Modell ist eine neue Zeile in
# prompts/CHANGELOG.md, kein stiller Tausch.
EVAL_MODELL=qwen/qwen3-8b
# Nur fuer gehostete Endpunkte (OpenRouter); LM Studio braucht keinen.
EVAL_API_KEY=

# ── promptfoo (evals/suite_*.yaml) ──────────────────────────────────────
# LM Studio: kein Schluessel noetig, die Suite setzt apiKey: lm-studio.
# Alternative ohne lokale Hardware, kostenlos mit Rate-Limit:
# OPENROUTER_API_KEY=
# Fuer evals/lauf.py dann:
# EVAL_BASE_URL=https://openrouter.ai/api/v1
# EVAL_MODELL=qwen/qwen3-8b:free
# EVAL_API_KEY=<derselbe Schluessel>
